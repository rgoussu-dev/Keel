# Production compose for <%= projectName %>: the assets image the
# release pipeline pushed populates a named volume as an init
# container (clear-then-copy, then env.js templated from the
# environment), and an unmodified official nginx serves the volume
# with the SPA's history-API-fallback config mounted read-only.
# 12-factor, binding: one bundle serves every environment — the API
# base URL is injected at deploy time, never baked in — and a
# frontend release replaces the assets image and re-runs it; nginx
# never rebuilds.
#
#   IMAGE=<registry>/<repo>:v1.2.3 docker compose -f deploy/compose.yaml up -d
volumes:
  spa-assets:

services:
  spa-assets:
    image: ${IMAGE:?set IMAGE to the assets image the release pipeline pushed}
    restart: 'no'
    environment:
      # The app reads window.__ENV__ from env.js at boot; the init
      # container writes it from these variables at deploy time.
      API_BASE_URL: ${API_BASE_URL:-/api}
    volumes:
      - spa-assets:/assets

  web:
    image: nginx:alpine
    ports:
      - '${PORT:-8080}:80'
    volumes:
      - spa-assets:/usr/share/nginx/html:ro
      - ../nginx.conf:/etc/nginx/conf.d/default.conf:ro
    depends_on:
      spa-assets:
        condition: service_completed_successfully
    restart: unless-stopped
