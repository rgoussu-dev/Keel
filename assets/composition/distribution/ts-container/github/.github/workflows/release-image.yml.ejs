name: release-image

on:
  push:
    tags:
      - 'v*'

permissions:
  contents: read
  packages: write

jobs:
  publish:
    name: build & push container image
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7

      - name: Log in to GHCR
        uses: docker/login-action@v4
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      # No host build: Node runs the sources directly, so the
      # Dockerfile the containerization vertical emitted copies the
      # workspace and installs production dependencies inside the
      # image. The pushed image is environment-agnostic: config rides
      # the environment of whatever runs it (see deploy/). GHCR
      # requires a lowercase repository path.
      - name: Build and push the image
        run: |
          image="ghcr.io/$(echo "$GITHUB_REPOSITORY" | tr '[:upper:]' '[:lower:]')"
          docker build -t "$image:$GITHUB_REF_NAME" -t "$image:latest" .
          docker push "$image:$GITHUB_REF_NAME"
          docker push "$image:latest"
