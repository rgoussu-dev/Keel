# Release (keel distribution): build the container image and push it
# to the GitLab Container Registry on every v* tag. No host build:
# Node runs the sources directly, so the Dockerfile the
# containerization vertical emitted copies the workspace and installs
# production dependencies inside the image. The pushed image is
# environment-agnostic: config rides the environment of whatever
# runs it (see deploy/).
release-image:
  stage: deploy
  rules:
    - if: '$CI_COMMIT_TAG =~ /^v/'
  image: docker:latest
  services:
    - docker:dind
  script:
    - docker login -u "$CI_REGISTRY_USER" -p "$CI_REGISTRY_PASSWORD" "$CI_REGISTRY"
    - docker build -t "$CI_REGISTRY_IMAGE:$CI_COMMIT_TAG" -t "$CI_REGISTRY_IMAGE:latest" .
    - docker push "$CI_REGISTRY_IMAGE:$CI_COMMIT_TAG"
    - docker push "$CI_REGISTRY_IMAGE:latest"
