<% if (pm === 'pnpm') { -%>
image: node:<%= nodeVersion %>

build:
  script:
    # corepack provisions the pnpm version pinned by the workspace's
    # own `packageManager` field — no version to drift here.
    - corepack enable
    - pnpm config set store-dir $CI_PROJECT_DIR/.pnpm-store
    - pnpm install --frozen-lockfile
<% if (formatCheck) { -%>
    - <%- formatCheck %>
<% } -%>
    - pnpm run typecheck
    - pnpm run --if-present lint
    - pnpm run --if-present build
    - pnpm test
<% if (lintCheck) { -%>
    - <%- lintCheck %>
<% } -%>
  cache:
    key: pnpm
    paths:
      - .pnpm-store
<% } else { -%>
image: node:<%= nodeVersion %>

variables:
  npm_config_cache: "$CI_PROJECT_DIR/.npm"

build:
  script:
    - npm ci
<% if (formatCheck) { -%>
    - <%- formatCheck %>
<% } -%>
    - npm run typecheck
    - npm run lint --if-present
    - npm run build --if-present
    - npm test
<% if (lintCheck) { -%>
    - <%- lintCheck %>
<% } -%>
  cache:
    key: npm
    paths:
      - .npm
<% } -%>
