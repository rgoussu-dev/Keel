# The official image tracks the latest stable toolchain — the same
# currency `rustup update stable` buys the GitHub flavor.
image: rust:latest

build:
  script:
<% if (formatCheck) { -%>
    - <%- formatCheck %>
<% } -%>
    - cargo build --workspace
    - cargo test --workspace
<% if (lintCheck) { -%>
    - <%- lintCheck %>
<% } -%>
