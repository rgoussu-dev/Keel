# The image tag is keel's pinned Go minor — the same one go.mod
# directs, rendered from one registry entry rather than restated
# here. The Go toolchain mechanism (on by default) upgrades past it
# to whatever go.mod asks for, so the tag only has to be recent
# enough to read the directive.
image: golang:<%= goVersion %>

build:
  script:
<% if (formatCheck) { -%>
    - <%- formatCheck %>
<% } -%>
    - go build ./...
    - go test ./...
<% if (lintCheck) { -%>
    - <%- lintCheck %>
<% } -%>
