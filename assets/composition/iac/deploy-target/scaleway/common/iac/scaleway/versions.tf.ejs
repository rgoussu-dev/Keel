# Remote state per binding spec §5, in the Object Storage bucket
# bootstrap.sh provisions; one state per environment via workspaces.
# Backend blocks cannot read variables — the bucket name is rendered
# literally here and in bootstrap/main.tf, keep the two in sync.
# Credentials ride the environment, never this file: the state
# backend reads the Scaleway API key as AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY.
terraform {
  required_version = ">= 1.6"

  required_providers {
    scaleway = {
      source  = "scaleway/scaleway"
      version = "~> 2.0"
    }
  }

  backend "s3" {
    bucket = "<%= projectName %>-tofu-state"
    key    = "iac/scaleway/terraform.tfstate"
    region = "fr-par"
    endpoints = {
      s3 = "https://s3.fr-par.scw.cloud"
    }
    # Object Storage speaks S3 but is not AWS: every AWS-side
    # validation is skipped.
    skip_credentials_validation = true
    skip_requesting_account_id  = true
    skip_metadata_api_check     = true
    skip_region_validation      = true
    skip_s3_checksum            = true
  }
}

# Auth via SCW_ACCESS_KEY / SCW_SECRET_KEY / SCW_DEFAULT_PROJECT_ID
# in the environment.
provider "scaleway" {
  region = "fr-par"
  zone   = "fr-par-1"
}
