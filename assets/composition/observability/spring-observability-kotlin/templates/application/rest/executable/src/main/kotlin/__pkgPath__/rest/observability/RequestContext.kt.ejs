package <%= basePackage %>.rest.observability

import org.springframework.stereotype.Component
import org.springframework.web.context.annotation.RequestScope

/**
 * Per-request correlation context, populated by
 * [RequestContextFilter] from the inbound headers before any
 * controller code runs.
 *
 * Extension point: to propagate another field (a user id, a request
 * source, …), add it here and parse it in [RequestContextFilter] —
 * the tenant id below is the worked example. Keep all header parsing
 * in the filter so the rest of the application only ever reads this
 * bean.
 */
// Explicit bean name: the default ("requestContext") is too close to
// framework-owned names; the filter's default would even collide with
// Boot's own requestContextFilter bean.
@Component("observabilityRequestContext")
@RequestScope
class RequestContext {

    var correlationId: String = ""

    /** The tenant id, or null outside multi-tenant calls. */
    var tenantId: String? = null

    companion object {
        /** Header carrying the caller-supplied correlation id. */
        const val CORRELATION_ID_HEADER = "X-Correlation-Id"

        /** Header carrying the tenant id in multi-tenant scenarios. */
        const val TENANT_ID_HEADER = "X-Tenant-Id"
    }
}
