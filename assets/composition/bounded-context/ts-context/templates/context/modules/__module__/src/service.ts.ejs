import type { Mediator } from '<%= kernelPkg %>';
import { <%= module %>Command } from './domain/contract/index.ts';

/**
 * What this context offers a **peer context** — the seam that makes
 * carving it out into its own service a wiring change rather than a
 * rewrite. A peer depends on this entry point
 * (`<%= contextPkg %>/service`) and on nothing else of ours; swap it
 * for an HTTP client and the consumer does not change.
 *
 * # Why an added context gets one at all
 *
 * The context `--with-peer-context` scaffolds has none: it is a pure
 * consumer, and nothing in the emitted workspace consumes it. A
 * context you add is different — the next thing you are likely to do
 * is add another that reaches this one, and a context with no seam can
 * never be reached.
 *
 * # It is spelled like the skeleton's seam on purpose
 *
 * `greeting` publishes `GreetingService.greet(name): Promise<string>`;
 * this publishes `<%= Module %>Service.<%= module %>For(subject):
 * Promise<string>`. Same shape, this context's name in it — so a
 * gateway generated by `--consumes` reads identically whether the
 * context it reaches is keel's own skeleton or one you added.
 *
 * Every type crossing this seam is declared here, and the method
 * returns a `string` rather than the domain's `<%= Module %>Result` on
 * purpose: a DTO of our own can change shape without a peer's compile
 * breaking, and — the part TypeScript will not catch for us — a domain
 * type handed across would let a consumer bind to our vocabulary
 * without ever importing our package. The rule governs this file's
 * exported signatures and only this file's.
 */
export interface <%= Module %>Service {
  /** Answers for `subject`, or rejects with the domain's message. */
  <%= module %>For(subject: string): Promise<string>;
}

/** Builds the peer-facing service over the assembled mediator. */
export function create<%= Module %>Service(mediator: Mediator): <%= Module %>Service {
  return {
    async <%= module %>For(subject: string): Promise<string> {
      const result = await mediator.dispatch(<%= module %>Command(subject));
      if (!result.ok) throw result.error;
      return result.value.detail;
    },
  };
}
