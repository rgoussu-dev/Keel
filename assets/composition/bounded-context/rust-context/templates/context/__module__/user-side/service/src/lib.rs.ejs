//! The **peer seam** of the <%= module %> context: the one crate
//! another bounded context is allowed to depend on.
//!
//! # Why an added context gets one at all
//!
//! The context `--with-peer-context` scaffolds has no seam — it is a
//! pure consumer, and nothing in the emitted project consumes *it*. A
//! context you add with `keel add module` is different: the next thing
//! you are likely to do is add another one that reaches this one, and
//! a context with no seam can never be reached. So this crate exists
//! from the start, and `keel add module <other> --consumes <%= module %>`
//! works without you having to build the seam by hand first.
//!
//! # The rule this crate exists to hold
//!
//! **Every type in this crate's public API must be declared by this
//! crate.** Not by `<%= module %>-domain-contract`, not by
//! `<%= module %>-domain-core` — here. [`<%= Module %>`] and
//! [`<%= Module %>Unavailable`] below are that: DTOs owned by the seam,
//! translated from the domain on the way out.
//!
//! The reason is what a Cargo dependency *is*. A consumer that depends
//! on this crate can name everything this crate exports, so if a
//! signature here returned `<%= moduleIdent %>_domain_contract::<%= Module %>Command`,
//! every gateway in the workspace would hold a value of this context's
//! domain type.
//!
//! # It is spelled like the skeleton's seam on purpose
//!
//! `greeting`'s seam is `GreetingService::greeting_for(&str) ->
//! Result<Greeting, GreetingUnavailable>`, and this one is the same
//! shape with this context's name in it. That is not decoration: it
//! means a gateway generated by `--consumes` reads identically whether
//! the context it reaches is keel's own skeleton or one you added, and
//! keel needs no table of per-context seam spellings to emit it.
//!
//! # What the compiler does and does not enforce
//!
//! It enforces less than it looks. The crate graph stops a consumer
//! **naming** a crate it has no edge to — a gateway without a
//! `<%= module %>-domain-contract` dependency cannot write that path,
//! and gets `E0432: unresolved import`. It does **not** stop a domain
//! type *flowing* across this seam: a consumer can bind whatever a
//! public function returns and read its fields, because inference
//! supplies the type it could never write. So the rule above is a
//! **convention**, and `cargo tree -p <consumer>` names the one crate a
//! reviewer must look at.

use std::fmt;

use <%= moduleIdent %>_domain_contract::{<%= Module %>Command, <%= Module %>Port};
use platform_kernel::{BoxFuture, boxed};

/// What the <%= module %> context tells a peer — this seam's own DTO.
///
/// Deliberately not a re-export of anything in the domain. It carries
/// what a peer needs and nothing else, so widening the domain does not
/// silently widen what peers can see.
#[derive(Debug, Clone, PartialEq, Eq)]
pub struct <%= Module %> {
    /// The outcome, already flattened out of the domain's vocabulary.
    pub message: String,
}

/// Why <%= module %> could not answer — again this seam's own type,
/// not the domain's error.
#[derive(Debug, Clone, PartialEq, Eq)]
pub struct <%= Module %>Unavailable {
    /// Human-readable explanation.
    pub reason: String,
}

impl fmt::Display for <%= Module %>Unavailable {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        write!(f, "<%= module %> unavailable: {}", self.reason)
    }
}

impl std::error::Error for <%= Module %>Unavailable {}

/// What a peer context may ask of <%= module %>.
///
/// Async — and therefore [`BoxFuture`] rather than `async fn` — for
/// two reasons. It is wired behind `Arc<dyn <%= Module %>Service>` at
/// assembly points, which `async fn` in a trait cannot support; and a
/// cross-context call is exactly the thing that becomes a network hop
/// the day this context is carved out into its own service.
pub trait <%= Module %>Service: Send + Sync {
    /// Answers for `subject`.
    fn <%= moduleIdent %>_for(
        &self,
        subject: &str,
    ) -> BoxFuture<'_, Result<<%= Module %>, <%= Module %>Unavailable>>;
}

/// Assembles the seam over the context's own core.
pub fn new_<%= moduleIdent %>_service(
    inner: impl <%= Module %>Port + Send + Sync + 'static,
) -> impl <%= Module %>Service + 'static {
    CoreBackedService { inner }
}

struct CoreBackedService<P: <%= Module %>Port + Send + Sync> {
    inner: P,
}

impl<P: <%= Module %>Port + Send + Sync> <%= Module %>Service for CoreBackedService<P> {
    fn <%= moduleIdent %>_for(
        &self,
        subject: &str,
    ) -> BoxFuture<'_, Result<<%= Module %>, <%= Module %>Unavailable>> {
        let cmd = <%= Module %>Command {
            subject: subject.to_string(),
        };
        boxed! {
            // Translation happens here, on the way out, and it is the
            // whole job: a domain value in, a seam DTO out.
            match self.inner.handle(cmd).await {
                Ok(result) => Ok(<%= Module %> { message: result.detail }),
                Err(err) => Err(<%= Module %>Unavailable { reason: err.to_string() }),
            }
        }
    }
}
