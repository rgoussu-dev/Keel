import type { Context } from '<%= contextProtocolPkg %>';
<% if (hasConsumes && consumesIsSkeleton) { %>import {
  create<%= SkeletonPort %>,
  create<%= Skeleton %>Store,
  type <%= SkeletonPort %>,
  type <%= Skeleton %>ReadModel,
} from '<%= consumesPkg %>';
import { create<%= Consumes %>Service } from '<%= consumesSeamPkg %>';
<% } %><% if (hasConsumes && !consumesIsSkeleton) { %>import type { <%= Consumes %>Service } from '<%= consumesSeamPkg %>';
// A fresh <%= consumes %> for the self-contained assembler below, from
// that context's own wiring module beside this one: what <%= consumes %>
// needs is a fact of *that* context, and only that module has it.
import { create<%= Consumes %>ContextService } from './<%= consumes %>';
<% } %>import {
  create<%= Module %>,
  create<%= Module %>Store,
<% if (hasConsumes) { %>  create<%= Consumes %>Gateway,
<% } %>  <%= module %>Context,
  <%= module %>RecordsContext,
} from '<%= contextPkg %>';
import { create<%= Module %>Service, type <%= Module %>Service } from '<%= seamPkg %>';

/**
 * Wiring for the <%= module %> context.
<% if (hasConsumes) { %> *
 * <%= Module %> reaches <%= consumes %> through one edge and one only:
 * the gateway below is constructed over `<%= consumesSeamPkg %>`, that
 * context's seam. Nothing here hands <%= module %> a *domain* type
 * belonging to <%= consumes %> — this file is where such a violation
 * would be written, so this is where the rule is stated.
<% if (consumesIsSkeleton) { %> *
 * The seam is built from <%= consumes %>'s assembled ports rather than
 * from a slice this function constructs: a seam that builds its own
 * breaks the moment a vertical rewires the factory behind it, and the
 * assembly has the ports in hand anyway.
<% } %><% } %> *
 * It returns its ports **and** its seam from one call so that both are
 * built over the same store instance. Two calls would give the page
 * one context's state and a peer another's, which is the kind of bug
 * that renders correctly right up until it does not.
 */
export interface <%= Module %>Wiring {
  readonly ports: readonly (readonly [Context<unknown>, unknown])[];
  readonly service: <%= Module %>Service;
}

export function create<%= Module %>Wiring(
<% if (hasConsumes && consumesIsSkeleton) { %>  <%= consumes %>: <%= SkeletonPort %>,
  <%= consumes %>Records: <%= Skeleton %>ReadModel,
<% } %><% if (hasConsumes && !consumesIsSkeleton) { %>  <%= consumes %>: <%= Consumes %>Service,
<% } %>): <%= Module %>Wiring {
  const records = create<%= Module %>Store();
<% if (hasConsumes && consumesIsSkeleton) { %>  const <%= module %> = create<%= Module %>(
    records,
    create<%= Consumes %>Gateway(create<%= Consumes %>Service(<%= consumes %>, <%= consumes %>Records)),
  );
<% } %><% if (hasConsumes && !consumesIsSkeleton) { %>  const <%= module %> = create<%= Module %>(records, create<%= Consumes %>Gateway(<%= consumes %>));
<% } %><% if (!hasConsumes) { %>  const <%= module %> = create<%= Module %>(records);
<% } %>  return {
    ports: [
      [<%= module %>Context, <%= module %>],
      [<%= module %>RecordsContext, records],
    ],
    service: create<%= Module %>Service(<%= module %>, records),
  };
}

/**
 * A **fresh, self-contained** <%= module %> — its own store, and its
 * own consumed chain built the same way.
 *
 * This is what `keel add module <other> --consumes <%= module %>`
 * binds its test to, and why it exists at all: a peer's assembly test
 * needs a real seam of this context, and reconstructing one at the
 * call site would mean knowing what *this* context consumes. Only this
 * module knows that, so only this module can build it — the same rule
 * the wiring above states about gateways, applied one level up.
 *
 * **Never call this from `main.ts`.** It builds a second store, which
 * is precisely the split-state bug the note on
 * {@link <%= Module %>Wiring} exists to prevent: the page would render
 * one instance's state while a peer read another's. `main.ts` holds
 * the one live wiring and passes its `service` on; this is for tests,
 * where a fresh instance per case is the point.
 */
export function create<%= Module %>ContextService(): <%= Module %>Service {
<% if (hasConsumes && consumesIsSkeleton) { %>  const <%= SkeletonReadModelVar %> = create<%= Skeleton %>Store();
  return create<%= Module %>Wiring(create<%= SkeletonPort %>(<%= SkeletonReadModelVar %>), <%= SkeletonReadModelVar %>)
    .service;
<% } %><% if (hasConsumes && !consumesIsSkeleton) { %>  return create<%= Module %>Wiring(create<%= Consumes %>ContextService()).service;
<% } %><% if (!hasConsumes) { %>  return create<%= Module %>Wiring().service;
<% } %>}
