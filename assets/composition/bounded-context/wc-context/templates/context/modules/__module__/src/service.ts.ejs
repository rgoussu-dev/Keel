import type { <%= Module %>, <%= Module %>ReadModel } from './domain/contract/index';

/**
 * What this context offers a **peer context** — the seam that makes
 * carving it out (into another bundle, another team's repo, its own
 * micro-frontend) a wiring change rather than a rewrite. A peer
 * depends on `<%= contextPkg %>/service` and on nothing else of ours.
 *
 * # Why an added context gets one at all
 *
 * The context `--with-peer-context` scaffolds has none: it is the
 * consumer of that pair, and a seam exists to be reached. A context
 * you add is different — the next thing you are likely to do is add
 * another that reaches this one.
 *
 * # It is spelled like the skeleton's seam on purpose
 *
 * `greeting` publishes `greet(name)` plus `latest()`; this publishes
 * `<%= module %>For(subject)` plus `latest()`. Fire-and-observe rather
 * than request/response, because that is the shape a browser context
 * publishes — so a gateway generated by `--consumes` reads the same
 * whichever context it reaches.
 *
 * Every type crossing the seam is declared here. `latest` returns a
 * `string | null` rather than this context's `<%= Module %>Record`: a
 * DTO of our own can change shape without a peer's compile breaking,
 * and a domain type handed across would let a consumer bind to our
 * vocabulary without importing our facade at all.
 *
 * The factory's parameters are the exception that proves it: they are
 * this context's ports, so only the **assembly** can call it — which
 * is correct, because the assembly is what wires contexts together.
 */
export interface <%= Module %>Service {
  /** Asks this context to act; the result arrives through {@link latest}. */
  <%= module %>For(subject: string): void;
  /** The latest record's detail, or null before the first one. */
  latest(): string | null;
}

/** Builds the peer-facing service over this context's own ports. */
export function create<%= Module %>Service(
  <%= module %>: <%= Module %>,
  records: <%= Module %>ReadModel,
): <%= Module %>Service {
  return {
    <%= module %>For(subject: string): void {
      <%= module %>.execute({ subject });
    },
    latest(): string | null {
      return records.latest()?.detail ?? null;
    },
  };
}
