package <%= basePackage %>.<%= module %>.userside.service

import <%= basePackage %>.<%= module %>.domain.contract.<%= Module %>Command
import <%= basePackage %>.platform.kernel.Mediator

/**
 * Maps the peer-facing API onto the module's dispatch seam. Like every
 * driving adapter it translates and never decides — the rule that
 * keeps an in-process call and a remote one interchangeable.
 */
class <%= Module %>ServiceAdapter(private val mediator: Mediator) : <%= Module %>Service {

    override fun <%= module %>For(subject: String): String =
        mediator.dispatch(<%= Module %>Command(subject)).detail
}
