package <%= basePackage %>.<%= module %>.userside.service

import org.junit.jupiter.api.Test

import <%= basePackage %>.<%= module %>.domain.contract.<%= Module %>Command
import <%= basePackage %>.<%= module %>.domain.contract.<%= Module %>Result
import <%= basePackage %>.platform.kernel.Command
import <%= basePackage %>.platform.kernel.Mediator

import org.junit.jupiter.api.Assertions.assertEquals

class <%= Module %>ServiceAdapterTest {

    @Test
    fun `dispatches the command and flattens what the module answered`() {
        val mediator = RecordingMediator(<%= Module %>Result("Hello, Ada!"))

        val answer = <%= Module %>ServiceAdapter(mediator).<%= module %>For("Ada")

        assertEquals("Hello, Ada!", answer)
        assertEquals(<%= Module %>Command("Ada"), mediator.dispatched)
    }

    /** A fake, not a mock — the house rule. */
    private class RecordingMediator(private val answer: Any) : Mediator {
        var dispatched: Command<*>? = null

        @Suppress("UNCHECKED_CAST")
        override fun <R> dispatch(command: Command<R>): R {
            dispatched = command
            return answer as R
        }
    }
}
