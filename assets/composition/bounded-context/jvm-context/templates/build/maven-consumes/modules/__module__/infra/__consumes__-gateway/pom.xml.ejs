<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId><%= basePackage %></groupId>
    <artifactId><%= projectName %></artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../../../pom.xml</relativePath>
  </parent>

  <artifactId><%= module %>-infra-<%= consumes %>-gateway</artifactId>

  <dependencies>
    <!-- The port this adapter implements is <%= module %>'s own. -->
    <dependency>
      <groupId><%= basePackage %></groupId>
      <artifactId><%= module %>-domain-contract</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- The peer's in-process API — the only inter-context edge this
         module adds to the build graph. Note what is absent and cannot
         be added: <%= consumes %>'s domain. That module declares its
         own contract `optional`, so <%= consumes %>.domain.contract is
         not on this compile classpath and an import of it fails to
         compile. -->
    <dependency>
      <groupId><%= basePackage %></groupId>
      <artifactId><%= consumes %>-user-side-service</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>6.1.3</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
