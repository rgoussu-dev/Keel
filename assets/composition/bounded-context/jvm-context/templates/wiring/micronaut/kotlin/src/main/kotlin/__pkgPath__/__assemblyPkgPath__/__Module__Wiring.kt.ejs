package <%= basePackage %>.<%= assemblyPkg %>

<% if (hasConsumes) { %>import io.micronaut.context.BeanProvider
<% } %>import io.micronaut.context.annotation.Factory
import jakarta.inject.Singleton

<% if (hasConsumes) { %>import <%= basePackage %>.<%= consumes %>.userside.service.<%= Consumes %>Service
import <%= basePackage %>.<%= module %>.domain.contract.<%= Consumes %>Client
import <%= basePackage %>.<%= module %>.infra.<%= consumes %>gateway.<%= Consumes %>Gateway
<% } %>import <%= basePackage %>.<%= module %>.domain.core.<%= Module %>Handler
import <%= basePackage %>.<%= module %>.userside.service.<%= Module %>Service
import <%= basePackage %>.<%= module %>.userside.service.<%= Module %>ServiceAdapter
import <%= basePackage %>.platform.kernel.Mediator

/**
 * Everything this assembly has to be told about the <%= module %>
 * context, in one class of its own.
 *
 * Deliberately not more bean methods on the shared composition root.
 * Two contexts reaching the same third one each declare a client port
 * and a gateway named after it — different types, identical simple
 * names — and one import block cannot name both. A class per context
 * has its own imports, and arrives as a new file rather than as a
 * patch to a file every other context is also patching.
 *
 * This is the one bootstrap where the **handler** is a bean too. The
 * Kotlin composition root hand-wires its handler list — `@Import` is
 * documented as Java-only, and discovery would put Micronaut's KSP
 * processor inside `domain/core` — so `MediatorFactory.mediator` takes
 * [<%= Module %>Handler] as a parameter, and this is what produces it.
 * Injecting the handler rather than its port is what keeps that list
 * safe to grow: `<%= Module %>Handler` is unique per context, where
 * two contexts consuming the same third one would both name a
 * `<%= Consumes %>Client`.
 */
@Factory
class <%= Module %>Wiring {

    /**
     * The <%= module %> module's use case, for the composition root's
     * explicit handler list.
     */
    @Singleton
<% if (hasConsumes) { %>    fun <%= module %>Handler(<%= consumes %>: <%= Consumes %>Client): <%= Module %>Handler =
        <%= Module %>Handler(<%= consumes %>)
<% } else { %>    fun <%= module %>Handler(): <%= Module %>Handler = <%= Module %>Handler()
<% } %>
    /**
     * The <%= module %> module's in-process API, offered to peer
     * modules. Emitted rather than left for you to write, because this
     * is what `keel add module <other> --consumes <%= module %>` binds
     * to: without it the seam module compiles and nothing can reach
     * it.
     */
    @Singleton
    fun <%= module %>Service(mediator: Mediator): <%= Module %>Service =
        <%= Module %>ServiceAdapter(mediator)
<% if (hasConsumes) { %>
    /**
     * Binds <%= module %>'s [<%= Consumes %>Client] port to the
     * <%= consumes %> module. This is the carve-out seam: swapping
     * [<%= Consumes %>Gateway] for an HTTP twin built on
     * <%= consumes %>'s published API moves that module into its own
     * service, and nothing in <%= module %> changes.
     *
     * The peer is injected as a [BeanProvider] and handed over as a
     * supplier, not resolved here. The mediator is built from every
     * handler, so resolving the <%= consumes %> service at this point
     * would close a construction cycle — mediator →
     * <%= Module %>Handler → <%= Consumes %>Client →
     * <%= Consumes %>Service → mediator — and the container would
     * refuse it as a circular dependency. Deferring the lookup to the
     * first call breaks it.
     */
    @Singleton
    fun <%= module %><%= Consumes %>Client(<%= consumes %>: BeanProvider<<%= Consumes %>Service>): <%= Consumes %>Client =
        <%= Consumes %>Gateway { <%= consumes %>.get() }
<% } %>}
