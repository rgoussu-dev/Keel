package <%= basePackage %>.<%= module %>.userside.service;

import org.junit.jupiter.api.Test;

import <%= basePackage %>.<%= module %>.domain.contract.<%= Module %>Command;
import <%= basePackage %>.<%= module %>.domain.contract.<%= Module %>Result;
import <%= basePackage %>.platform.kernel.Command;
import <%= basePackage %>.platform.kernel.Mediator;

import static org.junit.jupiter.api.Assertions.assertEquals;

class <%= Module %>ServiceAdapterTest {

    @Test
    void dispatchesTheCommandAndFlattensWhatTheModuleAnswered() {
        RecordingMediator mediator = new RecordingMediator(new <%= Module %>Result("Hello, Ada!"));

        String answer = new <%= Module %>ServiceAdapter(mediator).<%= module %>For("Ada");

        assertEquals("Hello, Ada!", answer);
        assertEquals(new <%= Module %>Command("Ada"), mediator.dispatched);
    }

    /** A fake, not a mock — the house rule. */
    private static final class RecordingMediator implements Mediator {

        private final Object answer;
        private Command<?> dispatched;

        private RecordingMediator(Object answer) {
            this.answer = answer;
        }

        @Override
        @SuppressWarnings("unchecked")
        public <R> R dispatch(Command<R> command) {
            dispatched = command;
            return (R) answer;
        }
    }
}
