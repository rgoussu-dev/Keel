package <%= basePackage %>.<%= module %>.userside.service;

import <%= basePackage %>.<%= module %>.domain.contract.<%= Module %>Command;
import <%= basePackage %>.platform.kernel.Mediator;

/**
 * Maps the peer-facing API onto the module's dispatch seam. Like
 * every driving adapter it translates and never decides — the rule
 * that keeps an in-process call and a remote one interchangeable.
 */
public final class <%= Module %>ServiceAdapter implements <%= Module %>Service {

    private final Mediator mediator;

    public <%= Module %>ServiceAdapter(Mediator mediator) {
        this.mediator = mediator;
    }

    @Override
    public String <%= module %>For(String subject) {
        return mediator.dispatch(new <%= Module %>Command(subject)).detail();
    }
}
