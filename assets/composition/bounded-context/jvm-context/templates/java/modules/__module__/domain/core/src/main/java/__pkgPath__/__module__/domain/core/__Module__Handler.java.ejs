package <%= basePackage %>.<%= module %>.domain.core;

<% if (hasConsumes) { %>import <%= basePackage %>.<%= module %>.domain.contract.<%= Consumes %>Client;
<% } %>import <%= basePackage %>.<%= module %>.domain.contract.<%= Module %>Command;
import <%= basePackage %>.<%= module %>.domain.contract.<%= Module %>Rejected;
import <%= basePackage %>.<%= module %>.domain.contract.<%= Module %>Result;
import <%= basePackage %>.platform.kernel.Command;
import <%= basePackage %>.platform.kernel.DomainHandler;
import <%= basePackage %>.platform.kernel.Handler;

/**
 * The <%= module %> context's placeholder use case — see
 * {@link <%= Module %>Command}, and rename both together.
<% if (hasConsumes) { %> *
 * <p>It reaches the <%= consumes %> context through the
 * {@link <%= Consumes %>Client} port and never learns that is what
 * happens: the assembly binds the port to a gateway, and swapping that
 * binding for a remote one is the whole of carving <%= consumes %> out
 * into its own service.
<% } %> */
@DomainHandler
public final class <%= Module %>Handler implements Handler<<%= Module %>Command, <%= Module %>Result> {
<% if (hasConsumes) { %>
    private final <%= Consumes %>Client <%= consumes %>;

    public <%= Module %>Handler(<%= Consumes %>Client <%= consumes %>) {
        this.<%= consumes %> = <%= consumes %>;
    }
<% } %>
    @Override
    public boolean supports(Command<?> command) {
        return command instanceof <%= Module %>Command;
    }

    @Override
    public <%= Module %>Result handle(<%= Module %>Command command) {
        String subject = command.subject() == null ? "" : command.subject().trim();
        if (subject.isEmpty()) {
            throw new <%= Module %>Rejected("subject must not be empty");
        }
<% if (hasConsumes) { %>        return new <%= Module %>Result(<%= consumes %>.askFor(subject));
<% } else { %>        return new <%= Module %>Result("<%= module %>: " + subject);
<% } %>    }
}
