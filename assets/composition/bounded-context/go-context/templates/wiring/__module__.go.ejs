// Wiring for the <%= module %> context, in this deployment unit's
// assembly package.
<% if (hasConsumes) { %>//
// <%= Module %> reaches <%= consumes %> through one edge and one only:
// the gateway below is constructed over <%= consumes %>'s seam, and
// nothing in this file hands <%= module %> a <%= consumes %> domain
// value — nothing could, since that domain sits behind
// modules/<%= consumes %>/internal/.
<% } %>//
// # Why every seam import is aliased
//
// Each bounded context spells its seam `package service`, so a file
// naming two of them has two `service` identifiers and does not
// compile. This assembly reaches at least this context's own seam, and
// with --consumes it reaches a second — so the collision is real here
// at two contexts, not three. Aliasing every seam as
// `<context>service` rather than only the one that collides keeps the
// rule mechanical: there is never a question of which import needs it.
//
// Go binds this file by directory. A file in a cmd/ directory joins
// that directory's package by existing, so unlike Rust's `mod` and the
// JVM's component scan there is no declaration to forget — the
// equivalent mistake in Go is landing this file somewhere that is not
// the assembly.
package main

import (
<%- wiringImports %>
)

// wire<%= Module %> assembles the <%= module %> context and returns it
// behind its driving port.
//
// Every value here is passed rather than named: this package cannot
// spell this context's domain types, and does not need to — `:=`
// supplies each type the assembly may not write.
func wire<%= Module %>() <%= seamAlias %>.<%= Module %>Service {
	return wire<%= Module %>Service()
}

// wire<%= Module %>Service assembles this context's **seam**, for
// peers to consume.
//
// Emitted beside the context rather than left for you to write,
// because this is what `keel add module <other> --consumes <%= module %>`
// binds to: without it, the seam package compiles and nothing reaches
// it.
func wire<%= Module %>Service() <%= seamAlias %>.<%= Module %>Service {
<% if (hasConsumes) { %>	// The seam of <%= consumes %>, obtained the only way it can be: the
	// skeleton's is built straight from its facade, an added context's
	// by that context's own wiring function beside this one.
	gateway := <%= consumes %>gateway.New(<%= consumedSeamExpr %>)
	return <%= seamAlias %>.New(<%= module %>.New<%= Module %>(gateway))
<% } else { %>	return <%= seamAlias %>.New(<%= module %>.New<%= Module %>())
<% } %>}
