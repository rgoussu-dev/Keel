// Package service is this bounded context's peer seam — what a
// *foreign* context imports to reach <%= module %>, and the one
// package of <%= module %>'s it should name.
//
// # Why an added context gets one at all
//
// The context `--with-peer-context` scaffolds has no seam: it is a
// pure consumer, and nothing in the emitted project consumes it. A
// context you add with `keel add module` is different — the next thing
// you are likely to do is add another that reaches this one, and a
// context with no seam can never be reached. So this package exists
// from the start, and `keel add module <other> --consumes <%= module %>`
// works without you building the seam by hand first.
//
// # What Go does and does not enforce here
//
// Less than it looks, and the same as for the skeleton's seam. Go's
// internal/ is scoped to the project root, so every package under it
// may import every other — nothing here narrows anything. What Go
// does enforce is *placement*: this context's domain sits behind
// modules/<%= module %>/internal/, so a foreign context importing it
// fails to build with "use of internal package … not allowed".
//
// A peer can therefore reach the facade and cannot name one thing the
// facade returns. So this package is where <%= module %> says what a
// peer may write down, and every type here is <%= module %>'s own.
//
// # It is spelled like the skeleton's seam on purpose
//
// greeting publishes GreetingService.GreetingFor returning its own
// Greeting and Unavailable; this publishes the same shape with this
// context's name in it. That means a gateway generated by --consumes
// reads identically whether the context it reaches is keel's own
// skeleton or one you added, and keel needs no table of per-context
// seam spellings to emit it.
package service

import (
<%- seamImports %>
)

// <%= Module %> is what crosses the seam: this context's answer,
// carried in this package's own type.
type <%= Module %> struct {
	Message string
}

// Unavailable reports that <%= module %> could not answer, with a
// reason a peer can read. This context's own error values stay behind
// the facade — a consumer that cannot name one cannot match on it
// either, so handing one across would give a peer an error it can only
// print.
type Unavailable struct {
	Reason string
}

func (e Unavailable) Error() string {
	return "<%= module %> unavailable: " + e.Reason
}

// <%= Module %>Service is the port a peer context depends on. Swap the
// implementation for an HTTP client the day <%= module %> becomes its
// own service and the consumer does not change — which is the whole
// claim the modulith makes.
type <%= Module %>Service interface {
	// <%= Module %>For answers for subject, or returns an [Unavailable]
	// saying why it could not.
	<%= Module %>For(subject string) (<%= Module %>, error)
}

// New builds the seam over this context's driving port.
//
// The parameter is this context's own port, so only code that can name
// one may call this — which means the assembly. A peer receives the
// built <%= Module %>Service and never constructs one.
func New(inner domain.<%= Module %>) <%= Module %>Service {
	return seam{inner: inner}
}

type seam struct {
	inner domain.<%= Module %>
}

func (s seam) <%= Module %>For(subject string) (<%= Module %>, error) {
	// Translation happens here, on the way out, and it is the whole
	// job: a domain value in, a seam DTO out.
	result, err := s.inner.Handle(domain.Command{Subject: subject})
	if err != nil {
		return <%= Module %>{}, Unavailable{Reason: err.Error()}
	}
	return <%= Module %>{Message: result.Detail}, nil
}
