// ValidName trims the name and rejects a blank one with the domain's
// ErrEmptyName.
func ValidName(name string) (string, error) {
	trimmed := strings.TrimSpace(name)
	if trimmed == "" {
		return "", greet.ErrEmptyName
	}
	return trimmed, nil
}

// ClampLimit bounds a read-window request to [1, 100].
func ClampLimit(limit int) int {
	return min(max(limit, 1), 100)
}
