import type { GreetingLog, RecordedGreeting } from '@<%= npmScope %>/domain-contract';

/**
 * The SQL seam this adapter queries through. Structural on purpose:
 * the unit-of-work package's `transactionalQueryable` satisfies it
 * (statements join the open unit of work), and so does a bare
 * `pg.Pool` — this package itself depends on no database driver.
 */
export interface SqlQueryable {
  query(text: string, values?: readonly unknown[]): Promise<{ rows: Record<string, unknown>[] }>;
}

const INSERT =
  'insert into greeting (name, greeted_at) values ($1, $2) returning id, name, greeted_at';
const RECENT = 'select id, name, greeted_at from greeting order by id desc limit $1';

/**
 * {@link GreetingLog} over plain SQL against the `greeting` table
 * (schema in `migrations/sql/`). Zero business logic: SQL in, domain
 * records out.
 */
export function createPgGreetingLog(sql: SqlQueryable): GreetingLog {
  return {
    async append(name: string, greetedAt: Date): Promise<RecordedGreeting> {
      const result = await sql.query(INSERT, [name, greetedAt]);
      const row = result.rows[0];
      if (!row) {
        throw new Error('insert into greeting returned no row');
      }
      return toRecorded(row);
    },
    async recent(limit: number): Promise<readonly RecordedGreeting[]> {
      const result = await sql.query(RECENT, [limit]);
      return result.rows.map(toRecorded);
    },
  };
}

function toRecorded(row: Record<string, unknown>): RecordedGreeting {
  return {
    id: Number(row['id']),
    name: String(row['name']),
    greetedAt: new Date(row['greeted_at'] as string | number | Date),
  };
}
