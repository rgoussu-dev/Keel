import { describe, expect, it } from 'vitest';
import { listGreetingsQuery, recordGreetingCommand } from '<%= contractSpec %>';
import { createFakeClock } from '<%= clockSpec %>';
import { createFakeGreetingLog } from '<%= greetingLogSpec %>';
import { createFakeUnitOfWork } from '<%= uowSpec %>';
import {
  createListGreetingsHandler,
  createRecordGreetingHandler,
} from '<%= coreSpec %>';

interface Scenario {
  readonly name: string;
}

const ADA: Scenario = { name: 'Ada' };
const BLANK: Scenario = { name: '   ' };

function factory() {
  const greetingLog = createFakeGreetingLog();
  const clock = createFakeClock(new Date('2026-01-01T12:00:00Z'));
  const unitOfWork = createFakeUnitOfWork();
  return {
    greetingLog,
    clock,
    unitOfWork,
    record: createRecordGreetingHandler(greetingLog, clock, unitOfWork),
    list: createListGreetingsHandler(greetingLog),
  };
}

describe('greeting-log handlers', () => {
  it('records inside one unit of work', async () => {
    const { record, unitOfWork } = factory();

    const result = await record.handle(recordGreetingCommand(ADA.name));

    expect(result.ok).toBe(true);
    if (result.ok) {
      expect(result.value.name).toBe('Ada');
      expect(result.value.greetedAt.toISOString()).toBe('2026-01-01T12:00:00.000Z');
    }
    expect(unitOfWork.committed()).toBe(1);
  });

  it('rejects blank names without touching the log', async () => {
    const { record, list, unitOfWork } = factory();

    const result = await record.handle(recordGreetingCommand(BLANK.name));

    expect(result.ok).toBe(false);
    if (!result.ok) {
      expect(result.error.code).toBe('greet.rejected');
    }
    expect(unitOfWork.committed()).toBe(0);
    const recent = await list.handle(listGreetingsQuery(10));
    expect(recent.ok && recent.value.length).toBe(0);
  });

  it('lists most recent first and clamps the limit', async () => {
    const { record, list } = factory();
    await record.handle(recordGreetingCommand('Ada'));
    await record.handle(recordGreetingCommand('Grace'));

    const recent = await list.handle(listGreetingsQuery(0));

    expect(recent.ok).toBe(true);
    if (recent.ok) {
      expect(recent.value.length).toBe(1);
      expect(recent.value[0]?.name).toBe('Grace');
    }
  });
});
