package <%= basePackage %>.application.api

import io.micronaut.test.support.TestPropertyProvider
import org.junit.jupiter.api.TestInstance
import org.testcontainers.containers.<%= tcClass %>

/**
 * Embedded-server tests get a throwaway <%= engineName %> from
 * Testcontainers: the fixture points the datasource at the container
 * and Flyway applies `migrations/sql/` at startup. Requires a Docker
 * daemon. Test classes extend this fixture — `TestPropertyProvider`
 * needs `PER_CLASS` lifecycle, which is inherited from here.
 */
@TestInstance(TestInstance.Lifecycle.PER_CLASS)
abstract class <%= dbFixture %> : TestPropertyProvider {

    override fun getProperties(): Map<String, String> {
        if (!DATABASE.isRunning) {
            DATABASE.start()
        }
        return mapOf(
            "datasources.default.url" to DATABASE.jdbcUrl,
            "datasources.default.username" to DATABASE.username,
            "datasources.default.password" to DATABASE.password,
        )
    }

    private companion object {
        val DATABASE = <%= tcClass %>("<%= dbImage %>")
    }
}
