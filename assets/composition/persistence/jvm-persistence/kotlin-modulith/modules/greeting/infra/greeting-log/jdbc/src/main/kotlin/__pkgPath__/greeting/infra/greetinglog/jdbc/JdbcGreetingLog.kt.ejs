package <%= basePackage %>.greeting.infra.greetinglog.jdbc

import java.sql.Statement
<% if (engineId === 'postgres') { -%>
import java.time.Instant
import java.time.OffsetDateTime
import java.time.ZoneOffset
<% } else { -%>
import java.sql.Timestamp
import java.time.Instant
<% } -%>

import javax.sql.DataSource

import <%= basePackage %>.greeting.domain.contract.greetinglog.GreetingLog
import <%= basePackage %>.greeting.domain.contract.greetinglog.RecordedGreeting

/**
 * [GreetingLog] over plain JDBC against the `greeting` table (schema
 * in `migrations/sql/`). Zero business logic: SQL in, domain records
 * out. Connections are drawn per call from the pool, so statements
 * enlist automatically in the transaction a `UnitOfWork` block
 * opened when the pool is transaction-aware.
 */
class JdbcGreetingLog(private val dataSource: DataSource) : GreetingLog {

    override fun append(name: String, greetedAt: Instant): RecordedGreeting =
        dataSource.connection.use { connection ->
            connection.prepareStatement(INSERT, Statement.RETURN_GENERATED_KEYS).use { statement ->
                statement.setString(1, name)
<% if (engineId === 'postgres') { -%>
                statement.setObject(2, OffsetDateTime.ofInstant(greetedAt, ZoneOffset.UTC))
<% } else { -%>
                statement.setTimestamp(2, Timestamp.from(greetedAt))
<% } -%>
                statement.executeUpdate()
                statement.generatedKeys.use { keys ->
                    check(keys.next()) { "insert into greeting returned no key" }
                    // By position: PostgreSQL returns the inserted row,
                    // MariaDB a lone insert-id column — the key leads both.
                    RecordedGreeting(keys.getLong(1), name, greetedAt)
                }
            }
        }

    override fun recent(limit: Int): List<RecordedGreeting> =
        dataSource.connection.use { connection ->
            connection.prepareStatement(RECENT).use { statement ->
                statement.setInt(1, limit)
                statement.executeQuery().use { rows ->
                    buildList {
                        while (rows.next()) {
                            add(
                                RecordedGreeting(
                                    rows.getLong("id"),
                                    rows.getString("name"),
<% if (engineId === 'postgres') { -%>
                                    rows.getObject("greeted_at", OffsetDateTime::class.java)
                                        .toInstant(),
<% } else { -%>
                                    rows.getTimestamp("greeted_at").toInstant(),
<% } -%>
                                ),
                            )
                        }
                    }
                }
            }
        }

    private companion object {
        const val INSERT = "insert into greeting (name, greeted_at) values (?, ?)"
        const val RECENT = "select id, name, greeted_at from greeting order by id desc limit ?"
    }
}
