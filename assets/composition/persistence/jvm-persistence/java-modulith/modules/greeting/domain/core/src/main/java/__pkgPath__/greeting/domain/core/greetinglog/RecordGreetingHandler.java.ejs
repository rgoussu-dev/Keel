package <%= basePackage %>.greeting.domain.core.greetinglog;

import <%= basePackage %>.greeting.domain.contract.Clock;
import <%= basePackage %>.greeting.domain.contract.UnitOfWork;
import <%= basePackage %>.greeting.domain.contract.greet.GreetRejected;
import <%= basePackage %>.greeting.domain.contract.greetinglog.GreetingLog;
import <%= basePackage %>.greeting.domain.contract.greetinglog.RecordGreetingCommand;
import <%= basePackage %>.greeting.domain.contract.greetinglog.RecordedGreeting;
import <%= basePackage %>.platform.kernel.Command;
import <%= basePackage %>.platform.kernel.DomainHandler;
import <%= basePackage %>.platform.kernel.Handler;

@DomainHandler
public final class RecordGreetingHandler
        implements Handler<RecordGreetingCommand, RecordedGreeting> {

    private final GreetingLog greetingLog;
    private final Clock clock;
    private final UnitOfWork unitOfWork;

    public RecordGreetingHandler(GreetingLog greetingLog, Clock clock, UnitOfWork unitOfWork) {
        this.greetingLog = greetingLog;
        this.clock = clock;
        this.unitOfWork = unitOfWork;
    }

    @Override
    public boolean supports(Command<?> command) {
        return command instanceof RecordGreetingCommand;
    }

    @Override
    public RecordedGreeting handle(RecordGreetingCommand command) {
        String name = command.name() == null ? "" : command.name().trim();
        if (name.isEmpty()) {
            throw new GreetRejected("name must not be blank");
        }
        return unitOfWork.inTransaction(() -> greetingLog.append(name, clock.now()));
    }
}
