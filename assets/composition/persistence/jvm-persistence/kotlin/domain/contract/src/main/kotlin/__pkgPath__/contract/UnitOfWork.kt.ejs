package <%= basePackage %>.contract

import java.util.function.Supplier

/**
 * The transactional boundary as a domain concept — a secondary port
 * shaped as a Unit of Work. Handlers wrap the state-changing work of
 * one command in [inTransaction] so every port touched inside the
 * block commits or rolls back together. How atomicity is achieved
 * (JTA, a framework transaction, a database session) is an adapter
 * concern behind this interface — the domain only decides where the
 * boundary sits.
 */
interface UnitOfWork {

    /**
     * Runs [work] as one atomic unit: committed when the block
     * returns, rolled back when it throws. Returns the block's
     * result; runtime exceptions propagate unchanged after rollback.
     */
    fun <T> inTransaction(work: Supplier<T>): T
}
