package <%= basePackage %>.application.api

import java.net.URI
import java.net.http.HttpClient
import java.net.http.HttpRequest
import java.net.http.HttpResponse

import org.junit.jupiter.api.Test
import org.springframework.beans.factory.annotation.Value
import org.springframework.boot.test.context.SpringBootTest
import org.springframework.context.annotation.Import

import org.assertj.core.api.Assertions.assertThat

/**
 * Drives the persistence slice end to end over real HTTP: the POST
 * really commits to the Testcontainers PostgreSQL and the GET really
 * reads rows back.
 */
@SpringBootTest(webEnvironment = SpringBootTest.WebEnvironment.RANDOM_PORT)
@Import(TestcontainersConfiguration::class)
class GreetingLogControllerTest {

    @Value("\${local.server.port}")
    var port: Int = 0

    private val client: HttpClient = HttpClient.newHttpClient()

    private fun post(body: String): HttpResponse<String> {
        val request = HttpRequest.newBuilder()
            .uri(URI.create("http://localhost:" + port + "/greetings"))
            .header("Content-Type", "application/json")
            .POST(HttpRequest.BodyPublishers.ofString(body))
            .build()
        return client.send(request, HttpResponse.BodyHandlers.ofString())
    }

    @Test
    fun recordsAGreetingDurablyAndListsItBack() {
        val recorded = post("{\"name\":\"Romain\"}")

        assertThat(recorded.statusCode()).isEqualTo(201)
        assertThat(recorded.body()).contains("\"name\":\"Romain\"").contains("\"greetedAt\":")

        val list = HttpRequest.newBuilder()
            .uri(URI.create("http://localhost:" + port + "/greetings"))
            .GET()
            .build()
        val recent = client.send(list, HttpResponse.BodyHandlers.ofString())

        assertThat(recent.statusCode()).isEqualTo(200)
        assertThat(recent.body()).contains("\"name\":\"Romain\"")
    }

    @Test
    fun mapsARejectedRecordToProblemDetails() {
        val rejected = post("{\"name\":\"  \"}")

        assertThat(rejected.statusCode()).isEqualTo(400)
        assertThat(rejected.body())
            .contains("\"type\":\"urn:problem-type:greet-rejected\"")
            .contains("\"detail\":\"name must not be blank\"")
    }
}
