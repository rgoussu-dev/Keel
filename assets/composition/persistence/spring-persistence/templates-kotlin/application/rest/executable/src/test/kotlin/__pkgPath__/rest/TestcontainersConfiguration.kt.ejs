package <%= basePackage %>.rest

import org.springframework.boot.test.context.TestConfiguration
import org.springframework.boot.testcontainers.service.connection.ServiceConnection
import org.springframework.context.annotation.Bean
import org.testcontainers.containers.<%= tcClass %>

/**
 * Boot tests get a throwaway <%= engineName %> from Testcontainers:
 * `@ServiceConnection` points the datasource at the container and
 * Flyway applies `migrations/sql/` at startup. Requires a Docker
 * daemon.
 */
@TestConfiguration(proxyBeanMethods = false)
class TestcontainersConfiguration {

    @Bean
    @ServiceConnection
    fun database(): <%= tcClass %><*> = <%= tcClass %>("<%= dbImage %>")
}
