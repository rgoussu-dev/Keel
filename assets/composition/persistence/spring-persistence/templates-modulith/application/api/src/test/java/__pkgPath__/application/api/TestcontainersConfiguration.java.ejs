package <%= basePackage %>.application.api;

import org.springframework.boot.test.context.TestConfiguration;
import org.springframework.boot.testcontainers.service.connection.ServiceConnection;
import org.springframework.context.annotation.Bean;
import org.testcontainers.containers.<%= tcClass %>;

/**
 * Boot tests get a throwaway <%= engineName %> from Testcontainers:
 * {@code @ServiceConnection} points the datasource at the container
 * and Flyway applies {@code migrations/sql/} at startup. Requires a
 * Docker daemon.
 */
@TestConfiguration(proxyBeanMethods = false)
public class TestcontainersConfiguration {

    @Bean
    @ServiceConnection
    public <%= tcClass %><?> database() {
        return new <%= tcClass %><>("<%= dbImage %>");
    }
}
