package <%= basePackage %>.greeting.userside.api;

import java.util.List;

import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestParam;
import org.springframework.web.bind.annotation.RestController;

import <%= basePackage %>.greeting.domain.contract.greetinglog.ListGreetingsQuery;
import <%= basePackage %>.greeting.domain.contract.greetinglog.RecordGreetingCommand;
import <%= basePackage %>.greeting.domain.contract.greetinglog.RecordedGreeting;
import <%= basePackage %>.greeting.userside.api.contract.RecordGreetingRequest;
import <%= basePackage %>.greeting.userside.api.contract.RecordedGreetingResponse;
import <%= basePackage %>.platform.kernel.Mediator;

/**
 * HTTP entry point of the persistence slice: maps transport DTOs to
 * the greeting-log command/query, dispatches via the mediator, and
 * maps the results back. No business logic.
 */
@RestController
public class GreetingLogController {

    private final Mediator mediator;

    public GreetingLogController(Mediator mediator) {
        this.mediator = mediator;
    }

    @PostMapping("/greetings")
    public ResponseEntity<RecordedGreetingResponse> record(
            @RequestBody RecordGreetingRequest request) {
        RecordedGreeting recorded = mediator.dispatch(new RecordGreetingCommand(request.name()));
        return ResponseEntity.status(HttpStatus.CREATED).body(toResponse(recorded));
    }

    @GetMapping("/greetings")
    public List<RecordedGreetingResponse> recent(
            @RequestParam(name = "limit", defaultValue = "10") int limit) {
        List<RecordedGreeting> recent = mediator.dispatch(new ListGreetingsQuery(limit));
        return recent.stream().map(GreetingLogController::toResponse).toList();
    }

    private static RecordedGreetingResponse toResponse(RecordedGreeting recorded) {
        return new RecordedGreetingResponse(recorded.id(), recorded.name(), recorded.greetedAt());
    }
}
