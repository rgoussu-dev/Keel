package <%= basePackage %>.application.api

import org.springframework.context.annotation.Configuration
import org.springframework.context.annotation.Profile
import org.springframework.web.servlet.config.annotation.CorsRegistry
import org.springframework.web.servlet.config.annotation.WebMvcConfigurer

/**
 * Allows the sibling SPA's dev origin (the Vite dev server) to call
 * this API directly during development. Dev-profile only — activate
 * with `SPRING_PROFILES_ACTIVE=dev ./gradlew bootRun` (or
 * `-Dspring-boot.run.profiles=dev` under Maven); never active in
 * production, where the SPA's traffic arrives same-origin through
 * its reverse proxy.
 */
@Configuration
@Profile("dev")
class CorsConfig : WebMvcConfigurer {

    override fun addCorsMappings(registry: CorsRegistry) {
        registry.addMapping("/**").allowedOrigins("http://localhost:5173")
    }
}
