import type { Greeting, GreetGateway } from '@<%= npmScope %>/domain-api';

/**
 * The canonical fake for the GreetGateway port — the reference
 * implementation of the contract, mirroring the backend's behaviour
 * (`Hello, <name>!`, falling back to `world`). Kept on its own
 * `./fake` subpath so DOM-less test programs never resolve the
 * `fetch`-based real adapter.
 */
export interface FakeGreetGateway extends GreetGateway {
  /** Names received, in call order. */
  readonly calls: readonly string[];
  /** Makes every subsequent call reject with the given message. */
  failWith(message: string): void;
}

/** Creates a FakeGreetGateway. */
export function createFakeGreetGateway(): FakeGreetGateway {
  const calls: string[] = [];
  let failure: string | null = null;
  return {
    calls,
    failWith(message: string): void {
      failure = message;
    },
    fetchGreeting(name: string): Promise<Greeting> {
      calls.push(name);
      if (failure !== null) return Promise.reject(new Error(failure));
      return Promise.resolve({ message: `Hello, ${name === '' ? 'world' : name}!` });
    },
  };
}
