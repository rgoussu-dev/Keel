import type { Greet, GreetCommand, GreetGateway } from '@<%= npmScope %>/domain-api';
import type { GreetingStore } from './greeting-store';

/**
 * Factory for the greet driving port, backed by the backend gateway.
 * `execute` stays fire-and-forget — the outcome (or the offline
 * fallback) surfaces through the read model, so elements keep a
 * single reactivity path. The assembly point supplies the gateway
 * (and decorates here for cross-cutting concerns).
 */
export function createGreet(gateway: GreetGateway, greetings: GreetingStore): Greet {
  return {
    execute(command: GreetCommand): void {
      void gateway
        .fetchGreeting(command.name.trim())
        .then((greeting) => greetings.publish(greeting))
        .catch(() => greetings.publish({ message: 'The greeting service is unreachable.' }));
    },
  };
}
