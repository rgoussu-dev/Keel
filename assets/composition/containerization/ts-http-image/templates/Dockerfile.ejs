# Thin image — no build stage twice over: Node runs the TypeScript
# sources directly, so the "artifact" is the sources themselves. The
# workspace has no runtime dependencies; install only links the
# workspace packages.
FROM node:22-alpine
WORKDIR /app
COPY . .
<% if (pm === 'pnpm') { -%>
RUN corepack enable && pnpm install --prod --frozen-lockfile
<% } else { -%>
RUN npm ci --omit=dev
<% } -%>
ENV NODE_ENV=production
ENV PORT=8080
EXPOSE 8080
USER node
CMD ["node", "<%= entryPoint %>"]
