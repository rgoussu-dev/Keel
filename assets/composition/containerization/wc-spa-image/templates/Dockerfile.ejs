# Assets image — the SPA's deployable is a bundle, not a server. No
# build stage: the image carries the Vite bundle the host build
# produced, and its entrypoint populates a mounted volume
# (clear-then-copy, plus env.js templated from the environment) and
# exits. It runs as an init container; an unmodified official nginx
# serves the volume (see compose.yaml). A frontend release replaces
# this image and re-runs it — nginx never rebuilds.
#
# Build the bundle first:
#
#   <%= buildCommand %>
FROM alpine:3
COPY <%= bundleDir %>/ /bundle/
COPY deploy-assets.sh /usr/local/bin/deploy-assets.sh
ENTRYPOINT ["/bin/sh", "/usr/local/bin/deploy-assets.sh"]
