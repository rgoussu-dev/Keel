/**
 * This context's custom-element registrations.
 *
 * Registration is a side effect, which is why it is a function and
 * why it sits behind its own entry point (`<%= elementsPkg %>`)
 * rather than the facade: defining an element upgrades already-parsed
 * markup and fires `connectedCallback` synchronously, so the assembly
 * has to be able to order it after the context provider is listening
 * — and importing the facade from a DOM-less program must not define
 * anything at all.
 */

import { GREETING_VIEW_TAG } from './element-tags';
import { GreetingView } from './user-side/elements/greeting-view';

export { GREETING_VIEW_TAG } from './element-tags';

/** Registers this context's elements. Idempotent. */
export function defineGreetingElements(): void {
  if (!customElements.get(GREETING_VIEW_TAG)) {
    customElements.define(GREETING_VIEW_TAG, GreetingView);
  }
}

declare global {
  interface HTMLElementTagNameMap {
    '<%= viewTag %>': GreetingView;
  }
}
