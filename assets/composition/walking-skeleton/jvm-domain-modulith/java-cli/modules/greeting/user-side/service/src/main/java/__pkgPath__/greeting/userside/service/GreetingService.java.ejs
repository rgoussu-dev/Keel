package <%= basePackage %>.greeting.userside.service;

/**
 * The greeting module's in-process API: the driving adapter a **peer
 * module** consumes.
 *
 * <p>It is a user-side adapter like the HTTP resource beside it —
 * the transport just happens to be the JVM call stack. A peer never
 * depends on this module's domain: it declares a driven port in its
 * own vocabulary, implements that port in its own {@code infra/}
 * over this interface, and the assembly binds the two. Swapping that
 * implementation for an HTTP client built from
 * {@code user-side/api/contract} is the whole of carving this module
 * out into its own service.
 *
 * <p>The DTOs this interface exposes are its own, deliberately: the
 * module's commands and domain types stay free to change behind it.
 */
public interface GreetingService {

    /** The greeting this module would produce for {@code name}. */
    String greetingFor(String name);
}
