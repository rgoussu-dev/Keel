package <%= basePackage %>.rest;

import io.micronaut.http.HttpRequest;
import io.micronaut.http.HttpResponse;
import io.micronaut.http.MutableHttpResponse;
import io.micronaut.http.annotation.Produces;
import io.micronaut.http.server.exceptions.ExceptionHandler;
import jakarta.inject.Singleton;

import <%= basePackage %>.contract.greet.GreetRejected;
import <%= basePackage %>.rest.contract.ProblemDetails;

/**
 * Maps the domain's {@link GreetRejected} error to an RFC 9457
 * Problem Details response. The interface adapter owns the
 * domain-error → transport translation; the domain never learns
 * about HTTP.
 */
@Produces
@Singleton
public class GreetRejectedHandler
        implements ExceptionHandler<GreetRejected, MutableHttpResponse<ProblemDetails>> {

    static final String PROBLEM_JSON = "application/problem+json";

    @Override
    public MutableHttpResponse<ProblemDetails> handle(HttpRequest request, GreetRejected rejected) {
        ProblemDetails body = new ProblemDetails(
                "urn:problem-type:greet-rejected",
                "Greeting rejected",
                400,
                rejected.getMessage(),
                request.getPath());
        return HttpResponse.badRequest(body).contentType(PROBLEM_JSON);
    }
}
