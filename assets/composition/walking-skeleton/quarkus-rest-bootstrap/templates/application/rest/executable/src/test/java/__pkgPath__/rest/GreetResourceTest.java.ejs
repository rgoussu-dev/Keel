package <%= basePackage %>.rest;

import io.quarkus.test.junit.QuarkusTest;
import org.junit.jupiter.api.Test;

import static io.restassured.RestAssured.given;
import static org.hamcrest.Matchers.equalTo;

@QuarkusTest
class GreetResourceTest {

    @Test
    void greetsByNameThroughMediator() {
        given()
                .queryParam("name", "Romain")
                .when()
                .get("/greet")
                .then()
                .statusCode(200)
                .body("greeting", equalTo("Hello, Romain!"));
    }

    @Test
    void defaultsToWorldWhenNoNameIsGiven() {
        given()
                .when()
                .get("/greet")
                .then()
                .statusCode(200)
                .body("greeting", equalTo("Hello, world!"));
    }

    @Test
    void mapsGreetRejectedToProblemDetails() {
        given()
                .queryParam("name", "  ")
                .when()
                .get("/greet")
                .then()
                .statusCode(400)
                .contentType(GreetRejectedMapper.PROBLEM_JSON)
                .body("type", equalTo("urn:problem-type:greet-rejected"))
                .body("title", equalTo("Greeting rejected"))
                .body("status", equalTo(400))
                .body("detail", equalTo("name must not be blank"))
                .body("instance", equalTo("/greet"));
    }
}
