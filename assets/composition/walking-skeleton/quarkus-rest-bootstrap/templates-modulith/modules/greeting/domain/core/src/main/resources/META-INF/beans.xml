<?xml version="1.0" encoding="UTF-8"?>
<!--
  Marks this domain module as a CDI bean archive so ArC discovers the
  @DomainHandler-annotated handlers inside it. An empty file would mean
  the same thing to CDI, but the mode is spelled out here: only
  annotated types become beans — the domain is never scanned wholesale.
-->
<beans xmlns="https://jakarta.ee/xml/ns/jakartaee"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
                           https://jakarta.ee/xml/ns/jakartaee/beans_4_0.xsd"
       version="4.0"
       bean-discovery-mode="annotated">
</beans>
