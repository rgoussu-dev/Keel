package <%= basePackage %>.greeting.userside.api;

import jakarta.ws.rs.core.Context;
import jakarta.ws.rs.core.Response;
import jakarta.ws.rs.core.UriInfo;
import jakarta.ws.rs.ext.ExceptionMapper;
import jakarta.ws.rs.ext.Provider;

import <%= basePackage %>.greeting.domain.contract.greet.GreetRejected;
import <%= basePackage %>.greeting.userside.api.contract.ProblemDetails;

/**
 * Maps the domain's {@link GreetRejected} error to an RFC 9457
 * Problem Details response. The interface adapter owns the
 * domain-error → transport translation; the domain never learns
 * about HTTP.
 */
@Provider
public class GreetRejectedMapper implements ExceptionMapper<GreetRejected> {
    @Context
    UriInfo uriInfo;

    @Override
    public Response toResponse(GreetRejected rejected) {
        ProblemDetails body = new ProblemDetails(
                "urn:problem-type:greet-rejected",
                "Greeting rejected",
                400,
                rejected.getMessage(),
                uriInfo.getRequestUri().getPath());
        return Response.status(400).type(ProblemDetails.PROBLEM_JSON).entity(body).build();
    }
}
