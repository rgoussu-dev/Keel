package <%= basePackage %>.greeting.userside.api;

import jakarta.inject.Inject;
import jakarta.ws.rs.DefaultValue;
import jakarta.ws.rs.GET;
import jakarta.ws.rs.Path;
import jakarta.ws.rs.Produces;
import jakarta.ws.rs.QueryParam;
import jakarta.ws.rs.core.MediaType;

import <%= basePackage %>.greeting.domain.contract.greet.GreetCommand;
import <%= basePackage %>.greeting.userside.api.contract.GreetResponse;
import <%= basePackage %>.platform.kernel.Mediator;

/**
 * HTTP entry point of the walking skeleton: maps the query string to
 * a {@link GreetCommand}, dispatches it via the mediator, and wraps
 * the result in the channel's transport DTO. No business logic.
 */
@Path("/greet")
public class GreetResource {
    private final Mediator mediator;

    @Inject
    public GreetResource(Mediator mediator) {
        this.mediator = mediator;
    }

    @GET
    @Produces(MediaType.APPLICATION_JSON)
    public GreetResponse greet(@QueryParam("name") @DefaultValue("world") String name) {
        return new GreetResponse(mediator.dispatch(new GreetCommand(name)));
    }
}
