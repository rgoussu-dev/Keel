[package]
name = "<%= assemblyCrate %>"
version.workspace = true
edition.workspace = true

# The binary keeps the project's own name whichever module layout the
# project uses — the layout dial is a structural choice, not a reason
# to rename somebody's executable.
[[bin]]
name = "<%= binName %>"
path = "src/main.rs"

[dependencies]
<%= contractCrate %> = { path = "<%= contractPath %>" }
axum = "0.8"
serde = { version = "1", features = ["derive"] }
serde_json = "1"
tokio = { version = "1", features = ["macros", "net", "rt-multi-thread"] }

[dev-dependencies]
http-body-util = "0.1"
tower = { version = "0.5", features = ["util"] }
