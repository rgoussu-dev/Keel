package <%= basePackage %>.contract.greet;

/**
 * Raised when a {@link GreetCommand} carries a blank name. A domain
 * error: primary adapters map it to their transport's error shape
 * (RFC 9457 Problem Details for REST); the domain never learns about
 * HTTP.
 */
public final class GreetRejected extends RuntimeException {

    public GreetRejected(String message) {
        super(message);
    }
}
