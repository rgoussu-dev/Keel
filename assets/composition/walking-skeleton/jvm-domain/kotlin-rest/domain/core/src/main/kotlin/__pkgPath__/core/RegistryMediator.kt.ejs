package <%= basePackage %>.core

import <%= basePackage %>.kernel.Command
import <%= basePackage %>.kernel.Handler
import <%= basePackage %>.kernel.Mediator

/**
 * Walks an immutable list of handlers and dispatches each command to
 * the first one whose [Handler.supports] returns true. A missing
 * handler is a wiring bug, not a runtime condition, so the
 * dispatcher throws.
 */
class RegistryMediator(handlers: List<Handler<*, *>>) : Mediator {

    private val handlers: List<Handler<*, *>> = handlers.toList()

    override fun <R> dispatch(command: Command<R>): R {
        for (handler in handlers) {
            if (handler.supports(command)) {
                @Suppress("UNCHECKED_CAST")
                val typed = handler as Handler<Command<R>, R>
                return typed.handle(command)
            }
        }
        throw IllegalStateException("no handler supports " + command.javaClass.name)
    }
}
