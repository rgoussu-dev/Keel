{
  "name": "<%= projectName %>",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
<% if (pm === 'pnpm') { -%>
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "node --watch application/rest/src/main.ts",
    "start": "node application/rest/src/main.ts",
    "test": "pnpm -r --if-present run test",
    "typecheck": "pnpm -r --if-present run typecheck"
  }
<% } else { -%>
  "workspaces": ["domain/*", "application/*", "infrastructure/*"],
  "scripts": {
    "dev": "node --watch application/rest/src/main.ts",
    "start": "node application/rest/src/main.ts",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
<% } -%>
}
