import { createServer, type Server, type ServerResponse } from 'node:http';
import type { Mediator } from '<%= kernelPkg %>';
import { greetCommand, GREET_REJECTED } from '<%= contextPkg %>';

/**
 * HTTP entry point of the walking skeleton: maps the query string to
 * a `GreetCommand`, dispatches it via the mediator, and maps the
 * `Result` to the transport — 200 with the greeting DTO, or an
 * RFC 9457 Problem Details body on rejection. No business logic.
 *
 * It reaches the greeting context through its facade and could not
 * reach further if it tried: the package publishes two entry points,
 * and everything under them is a resolution error here.
 */
export function createGreetServer(mediator: Mediator): Server {
  return createServer((request, response) => {
    const url = new URL(request.url ?? '/', 'http://localhost');
    if (request.method !== 'GET' || url.pathname !== '/greet') {
      problem(response, 404, 'not found', `no resource at ${url.pathname}`);
      return;
    }
    const name = url.searchParams.get('name') ?? 'world';
    void mediator
      .dispatch(greetCommand(name))
      .then((result) => {
        if (!result.ok) {
          const status = result.error.code === GREET_REJECTED ? 400 : 500;
          problem(response, status, result.error.code, result.error.message);
          return;
        }
        response.writeHead(200, { 'content-type': 'application/json; charset=utf-8' });
        response.end(JSON.stringify({ greeting: result.value.message }));
      })
      .catch((error: unknown) => {
        // A rejected dispatch promise is a defect (handlers return
        // Result), but it must not leave the response hanging. The
        // detail stays generic in production so internals never
        // reach clients.
        const detail =
          process.env.NODE_ENV !== 'production' && error instanceof Error
            ? error.message
            : 'unexpected failure';
        problem(response, 500, 'internal error', detail);
      });
  });
}

function problem(response: ServerResponse, status: number, title: string, detail: string): void {
  response.writeHead(status, { 'content-type': 'application/problem+json; charset=utf-8' });
  response.end(JSON.stringify({ type: 'about:blank', title, status, detail }));
}
