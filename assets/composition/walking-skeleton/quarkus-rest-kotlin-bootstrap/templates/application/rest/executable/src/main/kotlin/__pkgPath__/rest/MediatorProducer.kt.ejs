package <%= basePackage %>.rest

import jakarta.enterprise.context.ApplicationScoped
import jakarta.enterprise.inject.Produces
import jakarta.inject.Singleton

import <%= basePackage %>.core.RegistryMediator
import <%= basePackage %>.core.greet.GreetHandler
import <%= basePackage %>.kernel.Mediator

/**
 * The channel's composition root: hand-wires the Mediator with every
 * domain Handler. Replace with CDI lookup of all Handler beans once
 * the project grows past one or two handlers.
 */
@ApplicationScoped
class MediatorProducer {

    @Produces
    @Singleton
    fun mediator(): Mediator = RegistryMediator(listOf(GreetHandler()))
}
