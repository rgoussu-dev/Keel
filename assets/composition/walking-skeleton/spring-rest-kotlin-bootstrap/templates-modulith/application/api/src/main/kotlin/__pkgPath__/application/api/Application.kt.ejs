package <%= basePackage %>.application.api

import org.springframework.boot.autoconfigure.SpringBootApplication
import org.springframework.boot.runApplication
import org.springframework.context.annotation.ComponentScan
import org.springframework.context.annotation.FilterType

import <%= basePackage %>.platform.kernel.DomainHandler

/**
 * Boots the REST channel. The scan is declared explicitly because it
 * spans the assembly's own package — composition roots — and the whole
 * `greeting` module, whose controller lives in its user-side adapter
 * and whose handlers carry no Spring stereotype. Those are admitted by
 * the [DomainHandler] include filter instead, so the domain names no
 * framework and the composition root names the domain's marker.
 */
@SpringBootApplication
@ComponentScan(
    // spotless:off
    // keel:managed — do not edit by hand.
    // `keel add module <name>` rewrites this list, and anything you change
    // here is lost on the next run. The fence also stops the formatter
    // reflowing it, which is what keel anchors on.
    //
    // Every bounded context is named here, one by one. Nothing
    // scans the base package wholesale, so a context missing
    // from this list is never scanned: its handlers are never
    // discovered, and the application starts perfectly without
    // them.
    basePackages = ["<%= basePackage %>.application.api", "<%= basePackage %>.greeting"],
    // spotless:on
    includeFilters = [ComponentScan.Filter(type = FilterType.ANNOTATION, classes = [DomainHandler::class])],
)
class Application

fun main(args: Array<String>) {
    runApplication<Application>(*args)
}
