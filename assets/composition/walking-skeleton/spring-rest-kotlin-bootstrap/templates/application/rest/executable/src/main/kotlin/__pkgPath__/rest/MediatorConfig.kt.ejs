package <%= basePackage %>.rest

import org.springframework.context.annotation.Bean
import org.springframework.context.annotation.Configuration

import <%= basePackage %>.core.RegistryMediator
import <%= basePackage %>.kernel.Handler
import <%= basePackage %>.kernel.Mediator

/**
 * The channel's composition root: collects every discovered domain
 * [Handler] and builds the Mediator from them. Handlers reach this
 * list via the `@DomainHandler` include filter on [Application], so
 * adding an aggregate to the domain needs no edit here.
 */
@Configuration
class MediatorConfig {

    @Bean
    fun mediator(handlers: List<Handler<*, *>>): Mediator = RegistryMediator(handlers)
}
