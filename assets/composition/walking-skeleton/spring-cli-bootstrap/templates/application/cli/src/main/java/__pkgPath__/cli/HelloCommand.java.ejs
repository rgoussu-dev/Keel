package <%= basePackage %>.cli;

import org.springframework.stereotype.Component;
import picocli.CommandLine.Command;
import picocli.CommandLine.Option;

import <%= basePackage %>.contract.greet.GreetCommand;
import <%= basePackage %>.kernel.Mediator;

@Component
@Command(name = "hello", description = "Print a friendly greeting.")
public class HelloCommand implements Runnable {

    private final Mediator mediator;

    @Option(names = {"--name"}, defaultValue = "world", description = "Recipient of the greeting.")
    String name;

    public HelloCommand(Mediator mediator) {
        this.mediator = mediator;
    }

    @Override
    public void run() {
        String greeting = mediator.dispatch(new GreetCommand(name));
        System.out.println(greeting);
    }
}
