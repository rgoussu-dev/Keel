package <%= basePackage %>.cli;

import org.springframework.boot.CommandLineRunner;
import org.springframework.boot.ExitCodeGenerator;
import org.springframework.boot.SpringApplication;
import org.springframework.boot.autoconfigure.SpringBootApplication;
import picocli.CommandLine;
import picocli.CommandLine.IFactory;

/**
 * Boots the Spring container, then hands the raw arguments to
 * picocli. Commands are Spring beans instantiated through the
 * {@link IFactory} the picocli starter provides, so constructor
 * injection works inside them.
 */
@SpringBootApplication
public class Main implements CommandLineRunner, ExitCodeGenerator {

    private final IFactory factory;
    private final RootCommand rootCommand;
    private int exitCode;

    public Main(IFactory factory, RootCommand rootCommand) {
        this.factory = factory;
        this.rootCommand = rootCommand;
    }

    @Override
    public void run(String... args) {
        exitCode = new CommandLine(rootCommand, factory).execute(args);
    }

    @Override
    public int getExitCode() {
        return exitCode;
    }

    public static void main(String[] args) {
        System.exit(SpringApplication.exit(SpringApplication.run(Main.class, args)));
    }
}
