package <%= basePackage %>.cli;

import org.springframework.boot.CommandLineRunner;
import org.springframework.boot.ExitCodeGenerator;
import org.springframework.boot.SpringApplication;
import org.springframework.boot.autoconfigure.SpringBootApplication;
import org.springframework.context.annotation.ComponentScan;
import org.springframework.context.annotation.FilterType;
import picocli.CommandLine;
import picocli.CommandLine.IFactory;

import <%= basePackage %>.contract.DomainHandler;

/**
 * Boots the Spring container, then hands the raw arguments to
 * picocli. Commands are Spring beans instantiated through the
 * {@link IFactory} the picocli starter provides, so constructor
 * injection works inside them.
 *
 * <p>The scan is declared explicitly because it spans two packages:
 * this one and the domain's, whose handlers carry no Spring
 * stereotype and are admitted by the {@link DomainHandler} include
 * filter instead.
 */
@SpringBootApplication
@ComponentScan(
        // spotless:off
        // keel:managed — do not edit by hand.
        // `keel add module <name>` rewrites this list, and anything you change
        // here is lost on the next run. The fence also stops the formatter
        // reflowing it, which is what keel anchors on.
        //
        // Every bounded context is named here, one by one. Nothing
        // scans the base package wholesale, so a context missing
        // from this list is never scanned: its handlers are never
        // discovered, and the application starts perfectly without
        // them.
        basePackages = {"<%= basePackage %>.cli", "<%= basePackage %>.core"},
        // spotless:on
        includeFilters =
                @ComponentScan.Filter(type = FilterType.ANNOTATION, classes = DomainHandler.class))
public class Main implements CommandLineRunner, ExitCodeGenerator {

    private final IFactory factory;
    private final RootCommand rootCommand;
    private int exitCode;

    public Main(IFactory factory, RootCommand rootCommand) {
        this.factory = factory;
        this.rootCommand = rootCommand;
    }

    @Override
    public void run(String... args) {
        exitCode = new CommandLine(rootCommand, factory).execute(args);
    }

    @Override
    public int getExitCode() {
        return exitCode;
    }

    public static void main(String[] args) {
        System.exit(SpringApplication.exit(SpringApplication.run(Main.class, args)));
    }
}
