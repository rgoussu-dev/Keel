package <%= basePackage %>.cli

import io.micronaut.context.annotation.Factory
import jakarta.inject.Singleton

import <%= basePackage %>.core.RegistryMediator
import <%= basePackage %>.core.greet.GreetHandler
import <%= basePackage %>.kernel.Mediator

/**
 * The channel's composition root: hand-wires the Mediator with every
 * domain Handler. Add each new handler to the list below.
 *
 * This is the one bootstrap that does not discover `@DomainHandler`.
 * Micronaut resolves dependencies at compile time, so discovery would
 * require its KSP processor to run over `domain/core` — putting the
 * framework inside the domain's own build. The `@Import` escape hatch
 * the Java bootstrap uses to avoid that is documented as Java-only.
 * An explicit list is the honest trade: the domain build stays
 * framework-free, and the wiring stays visible in one place.
 */
@Factory
class MediatorFactory {

    @Singleton
    fun mediator(): Mediator = RegistryMediator(listOf(GreetHandler()))
}
