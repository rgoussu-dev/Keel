package <%= basePackage %>.application.cli

import java.io.ByteArrayOutputStream
import java.io.PrintStream
import java.nio.charset.StandardCharsets

import io.micronaut.configuration.picocli.PicocliRunner
import io.micronaut.context.env.Environment
import org.junit.jupiter.api.Test

import org.junit.jupiter.api.Assertions.assertEquals
import org.junit.jupiter.api.Assertions.assertTrue

/**
 * Drives the whole CLI — Micronaut context, picocli parsing,
 * mediator dispatch — exactly as `main` would, capturing what lands
 * on stdout.
 */
class HelloCommandTest {
    @Test
    fun greetsByNameThroughMediator() {
        val captured = ByteArrayOutputStream()
        val original = System.out
        System.setOut(PrintStream(captured, true, StandardCharsets.UTF_8))
        try {
            val exitCode = PicocliRunner.execute(
                Main::class.java,
                listOf(Environment.CLI, Environment.TEST),
                "hello",
                "--name",
                "Romain",
            )
            assertEquals(0, exitCode)
        } finally {
            System.setOut(original)
        }
        assertTrue(captured.toString(StandardCharsets.UTF_8).contains("Hello, Romain!"))
    }
}
