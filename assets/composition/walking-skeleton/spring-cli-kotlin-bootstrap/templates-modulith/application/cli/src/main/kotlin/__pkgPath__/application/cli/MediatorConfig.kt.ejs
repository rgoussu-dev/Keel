package <%= basePackage %>.application.cli

import org.springframework.context.annotation.Bean
import org.springframework.context.annotation.Configuration

import <%= basePackage %>.greeting.userside.service.GreetingService
import <%= basePackage %>.greeting.userside.service.GreetingServiceAdapter
import <%= basePackage %>.platform.kernel.Handler
import <%= basePackage %>.platform.kernel.Mediator
import <%= basePackage %>.platform.kernel.RegistryMediator

/**
 * The channel's composition root: collects every discovered domain
 * [Handler] and builds the Mediator from them. Handlers reach this
 * list via the `@DomainHandler` include filter on [Main], so adding
 * an aggregate to the domain needs no edit here.
 */
@Configuration
class MediatorConfig {
    @Bean
    fun mediator(handlers: List<Handler<*, *>>): Mediator = RegistryMediator(handlers)

    /**
     * The greeting module's in-process API, offered to peer modules.
     * Nothing consumes it yet — the second bounded context is the
     * first thing that will, through a driven port of its own.
     */
    @Bean
    fun greetingService(mediator: Mediator): GreetingService = GreetingServiceAdapter(mediator)
}
