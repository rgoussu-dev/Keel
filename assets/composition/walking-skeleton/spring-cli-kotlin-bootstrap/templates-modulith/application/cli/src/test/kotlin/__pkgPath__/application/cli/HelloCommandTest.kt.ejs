package <%= basePackage %>.application.cli

import org.junit.jupiter.api.Test
import org.junit.jupiter.api.extension.ExtendWith
import org.springframework.boot.SpringApplication
import org.springframework.boot.test.system.CapturedOutput
import org.springframework.boot.test.system.OutputCaptureExtension

import org.assertj.core.api.Assertions.assertThat

/**
 * Drives the whole CLI — Spring container, picocli parsing, mediator
 * dispatch — exactly as `main` would, capturing what lands on
 * stdout.
 */
@ExtendWith(OutputCaptureExtension::class)
class HelloCommandTest {
    @Test
    fun greetsByNameThroughMediator(output: CapturedOutput) {
        SpringApplication.run(Main::class.java, "hello", "--name", "Romain").use { context ->
            assertThat(SpringApplication.exit(context)).isZero()
        }
        assertThat(output).contains("Hello, Romain!")
    }
}
