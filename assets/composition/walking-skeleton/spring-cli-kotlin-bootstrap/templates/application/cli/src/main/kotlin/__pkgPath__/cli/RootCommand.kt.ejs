package <%= basePackage %>.cli

import org.springframework.stereotype.Component
import picocli.CommandLine.Command

/**
 * Top-level entry point for the CLI. Subcommands are declared on
 * [Command.subcommands]; add a new one by writing a Runnable
 * annotated with [Command] and listing it here.
 */
@Component
@Command(
    name = RootCommand.NAME,
    mixinStandardHelpOptions = true,
    description = ["Walking skeleton CLI scaffolded by keel."],
    subcommands = [HelloCommand::class],
)
class RootCommand {
    companion object {
        const val NAME = "<%= projectName %>"
    }
}
