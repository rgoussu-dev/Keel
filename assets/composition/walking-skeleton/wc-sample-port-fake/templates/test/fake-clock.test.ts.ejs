import { describe, expect, it } from 'vitest';
import type { Clock } from '<%= contractSpec %>';
import { createFakeClock, type FakeClock } from '<%= clockSpec %>';

interface Scenario {
  readonly start: Date;
  readonly advanceMs: number;
}

const anHourFromEpoch: Scenario = { start: new Date(0), advanceMs: 3_600_000 };

const factory = (scenario: Scenario): FakeClock => createFakeClock(scenario.start);

describe('FakeClock (Clock contract)', () => {
  it('starts at the given instant', () => {
    const clock: Clock = factory(anHourFromEpoch);
    expect(clock.now().getTime()).toBe(anHourFromEpoch.start.getTime());
  });

  it('advances by the given amount', () => {
    const fake = factory(anHourFromEpoch);
    fake.advance(anHourFromEpoch.advanceMs);
    expect(fake.now().getTime()).toBe(anHourFromEpoch.start.getTime() + anHourFromEpoch.advanceMs);
  });

  it('pins to an explicit instant', () => {
    const fake = factory(anHourFromEpoch);
    const pinned = new Date('2026-01-01T00:00:00Z');
    fake.set(pinned);
    expect(fake.now().toISOString()).toBe(pinned.toISOString());
  });

  it('returns independent Date instances', () => {
    const fake = factory(anHourFromEpoch);
    const first = fake.now();
    first.setFullYear(1999);
    expect(fake.now().getTime()).toBe(anHourFromEpoch.start.getTime());
  });
});
