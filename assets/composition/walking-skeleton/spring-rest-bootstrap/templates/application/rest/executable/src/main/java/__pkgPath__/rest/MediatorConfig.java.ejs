package <%= basePackage %>.rest;

import java.util.List;

import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;

import <%= basePackage %>.core.RegistryMediator;
import <%= basePackage %>.kernel.Handler;
import <%= basePackage %>.kernel.Mediator;

/**
 * The channel's composition root: collects every discovered domain
 * {@link Handler} and builds the Mediator from them. Handlers reach
 * this list via the {@code @DomainHandler} include filter on
 * {@link Application}, so adding an aggregate to the domain needs no
 * edit here.
 */
@Configuration
public class MediatorConfig {

    @Bean
    public Mediator mediator(List<Handler<?, ?>> handlers) {
        return new RegistryMediator(handlers);
    }
}
