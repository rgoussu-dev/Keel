package <%= basePackage %>.rest;

import jakarta.servlet.http.HttpServletRequest;

import org.springframework.http.MediaType;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.ExceptionHandler;
import org.springframework.web.bind.annotation.RestControllerAdvice;

import <%= basePackage %>.contract.greet.GreetRejected;
import <%= basePackage %>.rest.contract.ProblemDetails;

/**
 * Maps the domain's {@link GreetRejected} error to an RFC 9457
 * Problem Details response. The interface adapter owns the
 * domain-error → transport translation; the domain never learns
 * about HTTP.
 */
@RestControllerAdvice
public class GreetRejectedAdvice {

    static final String PROBLEM_JSON = "application/problem+json";

    @ExceptionHandler(GreetRejected.class)
    public ResponseEntity<ProblemDetails> onGreetRejected(
            GreetRejected rejected, HttpServletRequest request) {
        ProblemDetails body = new ProblemDetails(
                "urn:problem-type:greet-rejected",
                "Greeting rejected",
                400,
                rejected.getMessage(),
                request.getRequestURI());
        return ResponseEntity.status(400)
                .contentType(MediaType.parseMediaType(PROBLEM_JSON))
                .body(body);
    }
}
