<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId><%= basePackage %></groupId>
    <artifactId><%= projectName %></artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../../../pom.xml</relativePath>
  </parent>

  <artifactId>greeting-user-side-cli</artifactId>

  <!-- A driving adapter is a library the assembly mounts, never a
       runnable unit: no framework packaging plugin, no main class,
       no runtime configuration lives here. -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId><%= basePackage %></groupId>
      <artifactId>greeting-domain-contract</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId><%= basePackage %></groupId>
      <artifactId>platform-kernel</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- Annotation-only Jakarta APIs, meta-annotating @DomainHandler so
         each assembly's container can discover handlers. `provided`
         keeps them off every runtime classpath — the kernel declares
         intent, never a framework. Not transitive, so the modules that
         apply the marker repeat them. -->
    <dependency>
      <groupId>jakarta.inject</groupId>
      <artifactId>jakarta.inject-api</artifactId>
      <version>2.0.1</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>jakarta.enterprise</groupId>
      <artifactId>jakarta.enterprise.cdi-api</artifactId>
      <version>4.1.0</version>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>info.picocli</groupId>
      <artifactId>picocli-spring-boot-starter</artifactId>
      <version>4.7.7</version>
    </dependency>
  </dependencies>
</project>
