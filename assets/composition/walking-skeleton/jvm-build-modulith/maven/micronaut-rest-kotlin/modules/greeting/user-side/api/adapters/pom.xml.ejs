<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId><%= basePackage %></groupId>
    <artifactId><%= projectName %></artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../../../../pom.xml</relativePath>
  </parent>

  <artifactId>greeting-user-side-api-adapters</artifactId>

  <!-- A driving adapter is a library the assembly mounts, never a
       runnable unit: no framework packaging plugin, no main class,
       no runtime configuration lives here. -->

  <dependencies>
    <dependency>
      <groupId><%= basePackage %></groupId>
      <artifactId>greeting-user-side-api-contract</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId><%= basePackage %></groupId>
      <artifactId>greeting-domain-contract</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId><%= basePackage %></groupId>
      <artifactId>platform-kernel</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- Annotation-only Jakarta APIs, meta-annotating @DomainHandler so
         each assembly's container can discover handlers. `provided`
         keeps them off every runtime classpath — the kernel declares
         intent, never a framework. Not transitive, so the modules that
         apply the marker repeat them. -->
    <dependency>
      <groupId>jakarta.inject</groupId>
      <artifactId>jakarta.inject-api</artifactId>
      <version>2.0.1</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>jakarta.enterprise</groupId>
      <artifactId>jakarta.enterprise.cdi-api</artifactId>
      <version>4.1.0</version>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.jetbrains.kotlin</groupId>
      <artifactId>kotlin-stdlib</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jetbrains.kotlin</groupId>
      <artifactId>kotlin-reflect</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micronaut</groupId>
      <artifactId>micronaut-http-server-netty</artifactId>
    </dependency>
    <!-- ExceptionHandler and friends live in the server API; a library
         module carries no server runtime, unlike the assembly. -->
    <dependency>
      <groupId>io.micronaut</groupId>
      <artifactId>micronaut-http-server</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micronaut</groupId>
      <artifactId>micronaut-jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.module</groupId>
      <artifactId>jackson-module-kotlin</artifactId>
      <version>2.22.2</version>
    </dependency>
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
      <scope>runtime</scope>
    </dependency>
  </dependencies>

  <!-- Micronaut resolves beans at compile time and does it per
       compiled module, so a library module holding framework-annotated
       types has to run the processor itself — its Gradle twin says the
       same thing by applying `io.micronaut.library`. Without this the
       sources compile, the jar is produced and the application starts
       clean; there is simply no bean definition, so every route 404s.
       The processor version is left to the platform BOM the reactor
       root imports (maven-compiler-plugin 3.12+ resolves it from
       dependencyManagement). -->
  <build>
    <plugins>
      <!-- On Kotlin sources the processor runs through kapt, exactly as
           in the assembly; the Gradle twin reaches the same place
           through KSP. -->
      <plugin>
        <groupId>org.jetbrains.kotlin</groupId>
        <artifactId>kotlin-maven-plugin</artifactId>
        <version>${kotlin.version}</version>
        <executions>
          <execution>
            <id>kapt</id>
            <goals>
              <goal>kapt</goal>
            </goals>
            <configuration>
              <annotationProcessorPaths combine.self="override">
                <annotationProcessorPath>
                  <groupId>io.micronaut</groupId>
                  <artifactId>micronaut-inject-java</artifactId>
                  <version>${micronaut.version}</version>
                </annotationProcessorPath>
              </annotationProcessorPaths>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
