<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId><%= basePackage %></groupId>
    <artifactId><%= projectName %></artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../../../pom.xml</relativePath>
  </parent>

  <artifactId>greeting-user-side-service</artifactId>

  <dependencies>
    <!-- The peer-facing interface takes a Mediator, so the kernel is
         part of this module's own API. -->
    <dependency>
      <groupId><%= basePackage %></groupId>
      <artifactId>platform-kernel</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- The greeting commands behind that interface are NOT part of it.
         Maven's `compile` scope is transitive, so without `optional` a
         peer that depends on this module also gets the greeting domain
         on its compile classpath — and the seam this whole layout
         exists to enforce silently disappears. `optional` is Maven's
         only non-transitive compile scope, and it is what the Gradle
         twin spells `implementation`. `provided` would work at compile
         time and break at runtime: the adapter dispatches a real
         GreetCommand, so it needs the contract on its own runtime
         classpath. The assembly declares the contract directly, so
         nothing downstream is missing it. -->
    <dependency>
      <groupId><%= basePackage %></groupId>
      <artifactId>greeting-domain-contract</artifactId>
      <version>${project.version}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>6.1.3</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
