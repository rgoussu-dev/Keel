<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId><%= basePackage %></groupId>
    <artifactId><%= projectName %></artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>application-api</artifactId>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>

    <dependency>
      <groupId><%= basePackage %></groupId>
      <artifactId>platform-kernel</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId><%= basePackage %></groupId>
      <artifactId>greeting-domain-contract</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId><%= basePackage %></groupId>
      <artifactId>greeting-domain-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId><%= basePackage %></groupId>
      <artifactId>greeting-user-side-api-adapters</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId><%= basePackage %></groupId>
      <artifactId>greeting-user-side-service</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId><%= basePackage %></groupId>
      <artifactId>greeting-user-side-api-contract</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <version>${spring-boot.version}</version>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
