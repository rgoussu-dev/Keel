plugins {
    `java-library`
    id("io.micronaut.library") version "4.6.2"
}

// Micronaut resolves beans at compile time, so a library module holding
// adapters runs the annotation processor itself; only the assembly
// applies the `application` plugin.
micronaut {
    version("4.10.17")
    processing {
        incremental(true)
        annotations("<%= basePackage %>.*")
    }
}

// A driving adapter is a library the assembly mounts, never a
// runnable unit: no framework application plugin, no main class,
// no runtime configuration lives here.
dependencies {
    implementation("io.micronaut.picocli:micronaut-picocli")

    implementation(project(":modules:greeting:domain:contract"))
    implementation(project(":platform:kernel"))
}
