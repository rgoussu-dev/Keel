plugins {
    java
}

allprojects {
    group = "<%= basePackage %>"
    version = "0.1.0-SNAPSHOT"

    repositories {
        mavenCentral()
    }
}

subprojects {
    apply(plugin = "java")

    // Leaf project names repeat across the modulith — `contract` under
    // both domain/ and user-side/api/, `cli` under both application/
    // and user-side/ — and Gradle conflict-resolves subprojects sharing
    // module coordinates (group:name) into a single module. Derive each
    // group from the project path so every module's coordinates stay
    // unique.
    group = "<%= basePackage %>" + path.substringBeforeLast(':').replace(':', '.')

    // Archive *file* names must be unique for the same reason: flat
    // lib/ layouts pack libraries by file name, and Quarkus resolves
    // its application model by artifact — a colliding name puts the
    // assembly's own jar among its dependencies and the task graph goes
    // circular. Name each archive after its project path.
    tasks.withType<Jar>().configureEach {
        archiveBaseName.set(project.path.removePrefix(":").replace(':', '-'))
    }

    java {
        toolchain {
            languageVersion = JavaLanguageVersion.of(25)
        }
    }

    dependencies {
        // Required at test runtime since Gradle 9; the platform
        // launcher used to be auto-provided by `useJUnitPlatform()`
        // but is now an explicit dependency.
        "testRuntimeOnly"("org.junit.platform:junit-platform-launcher")
    }

    tasks.withType<Test> {
        useJUnitPlatform()
    }
}
