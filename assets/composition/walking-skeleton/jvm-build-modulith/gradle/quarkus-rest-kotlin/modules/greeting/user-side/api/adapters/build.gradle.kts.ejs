plugins {
    `java-library`
    kotlin("plugin.allopen")
}

// Quarkus proxies normal-scoped CDI beans, so the annotated Kotlin
// classes must compile open — the adapter module needs the same
// treatment as the assembly that mounts it.
allOpen {
    annotation("jakarta.ws.rs.Path")
    annotation("jakarta.ws.rs.ext.Provider")
    annotation("jakarta.enterprise.context.ApplicationScoped")
}

// A driving adapter is a library the assembly mounts, never a
// runnable unit: no framework application plugin, no main class,
// no runtime configuration lives here.
dependencies {
    implementation(enforcedPlatform("io.quarkus.platform:quarkus-bom:3.34.6"))
    implementation("io.quarkus:quarkus-kotlin")
    implementation("io.quarkus:quarkus-rest-jackson")

    api(project(":modules:greeting:user-side:api:contract"))
    implementation(project(":modules:greeting:domain:contract"))
    implementation(project(":platform:kernel"))
}
