// Package cli is the CLI primary adapter: it maps process arguments
// to domain commands, dispatches through the driving port, and maps
// the outcome back to streams and an exit code. Zero business logic.
package cli

import (
	"errors"
	"flag"
	"fmt"
	"io"

	"<%= domainImport %>"
)

const (
	exitOK    = 0
	exitError = 1
	exitUsage = 2
)

// App drives the greet use case from the terminal.
type App struct {
	greeter domain.Greeter
}

// New returns an App dispatching to greeter.
func New(greeter domain.Greeter) *App {
	return &App{greeter: greeter}
}

// Run parses args (the process arguments after the program name),
// executes the greet command, and writes the outcome to stdout or
// stderr. The returned int is the process exit code: 0 on success,
// 2 on usage or validation errors, 1 on anything else.
func (a *App) Run(args []string, stdout, stderr io.Writer) int {
	flags := flag.NewFlagSet("<%= projectName %>", flag.ContinueOnError)
	flags.SetOutput(stderr)
	name := flags.String("name", "World", "who to greet")
	if err := flags.Parse(args); err != nil {
		return exitUsage
	}

	message, err := a.greeter.Greet(domain.GreetCommand{Name: *name})
	if err != nil {
		fmt.Fprintf(stderr, "%s: %v\n", flags.Name(), err)
		if errors.Is(err, domain.ErrEmptyName) {
			return exitUsage
		}
		return exitError
	}
	fmt.Fprintln(stdout, message)
	return exitOK
}
