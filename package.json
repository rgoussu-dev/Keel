{
  "name": "@rgoussu.dev/keel",
  "version": "0.5.0-alpha",
  "description": "Opinionated project bootstrapper: one command scaffolds a runnable hexagonal walking skeleton — Java, Kotlin, Go, Rust, or TypeScript — with engineering conventions and Claude Code affordances built in.",
  "type": "module",
  "repository": {
    "url": "https://github.com/rgoussu-dev/Keel"
  },
  "bin": {
    "keel": "bin/keel.js"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "files": [
    "bin",
    "dist",
    "assets",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_LICENSES"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json -w",
    "keel": "pnpm build && node scripts/keel-local.mjs",
    "lint": "eslint src tests assets/web && prettier --check . && depcruise src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "vitest run tests/e2e",
    "test:mutation": "stryker run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build",
    "deps:check": "depcruise src"
  },
  "keywords": [
    "claude-code",
    "hexagonal",
    "ports-and-adapters",
    "trunk-based",
    "xp",
    "walking-skeleton",
    "scaffolding",
    "schematics",
    "cqrs",
    "mediator"
  ],
  "author": "rgoussu.dev",
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^7.2.0",
    "@rgoussu.dev/planks": "^0.3.1",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "ejs": "^3.1.10",
    "fs-extra": "^11.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/ejs": "^3.1.5",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.10.0",
    "dependency-cruiser": "^18.1.1",
    "eslint": "^9.16.0",
    "globals": "^15.14.0",
    "playwright": "^1.62.1",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.0",
    "yaml": "^2.9.0"
  }
}
